# Which LLM provider to use: anthropic, openai, gemini, qwen, kimi, or deepseek
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=4096

# --- OpenAI (GPT-4o, etc.) ---
# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_TOKENS=4096
# OPENAI_BASE_URL=              # optional, for custom OpenAI-compatible endpoints

# --- Google Gemini ---
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MAX_TOKENS=4096

# --- Qwen (DashScope) ---
# QWEN_API_KEY=your-key-here
# QWEN_MODEL=qwen-plus
# QWEN_MAX_TOKENS=4096

# --- Kimi (Moonshot AI) ---
# KIMI_API_KEY=your-key-here
# KIMI_MODEL=moonshot-v1-auto
# KIMI_MAX_TOKENS=4096

# --- DeepSeek ---
# DEEPSEEK_API_KEY=your-key-here
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MAX_TOKENS=4096

# Output language (default: English)
LANGUAGE=English
